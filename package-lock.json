{
  "name": "equipment-maintenance-hub",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "equipment-maintenance-hub",
      "version": "0.0.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ]
    },
    "apps/backend": {
      "name": "@equipment-hub/backend",
      "version": "0.0.0",
      "dependencies": {
        "@equipment-hub/contract": "*"
      }
    },
    "apps/frontend": {
      "name": "@equipment-hub/frontend",
      "version": "0.0.0",
      "dependencies": {
        "@equipment-hub/contract": "*"
      }
    },
    "node_modules/@equipment-hub/backend": {
      "resolved": "apps/backend",
      "link": true
    },
    "node_modules/@equipment-hub/contract": {
      "resolved": "packages/contract",
      "link": true
    },
    "node_modules/@equipment-hub/frontend": {
      "resolved": "apps/frontend",
      "link": true
    },
    "packages/contract": {
      "name": "@equipment-hub/contract",
      "version": "0.0.0"
    }
  }
}
